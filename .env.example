# Copie para .env e preencha. Nunca versione o .env.
DOMAIN=verifica.corevatech.com.br

# Atrás do Caddy, o IP real do cliente vem em X-Forwarded-For.
TRUST_PROXY=1
CLIENT_IP_HEADER=x-forwarded-for

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget → hostname: DOMAIN)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Limites
RATE_LIMIT=10
TARGET_RATE_LIMIT=6

# Sal para anonimizar IPs nos logs (gere com: openssl rand -hex 16)
LOG_SALT=
